<?xml version="1.0" encoding="UTF-8"?>
<!-- 三星电视（Tizen）打包用。用 Tizen Studio 新建 TV Web 项目，把 birthday/ 下的文件放进去，用这份 config.xml。
     Packaging for Samsung TV (Tizen): create a TV Web project in Tizen Studio, copy the site files in, use this config.xml. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://example.org/tenup" version="1.0.0" viewmodes="maximized">
  <tizen:application id="TenUpAlbm0.TenUp" package="TenUpAlbm0" required_version="5.5"/>
  <content src="index.html?mode=watch"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <name>十岁啦</name>
  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
  <access origin="https://fonts.googleapis.com" subdomains="true"/>
  <access origin="https://fonts.gstatic.com" subdomains="true"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
</widget>

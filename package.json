{
  "name": "trailmate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TrailMate - 朋友出游助手：跟车地图、营地Mesh通信、AA记账分摊",
  "scripts": {
    "dev": "vite",
    "server": "node server/signaling.js",
    "dev:all": "concurrently -n web,sig -c cyan,magenta \"vite --host\" \"node server/signaling.js\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "ws": "^8.21.0"
  }
}

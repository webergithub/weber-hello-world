{
  "name": "rar-recovery-desktop",
  "productName": "压缩包密码恢复",
  "version": "1.0.0",
  "description": "本地压缩包密码恢复桌面应用（Electron 外壳 + Python 后端）",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.local.rarrecovery",
    "productName": "压缩包密码恢复",
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "backend",
        "filter": [
          "serve.py",
          "recover.py",
          "recovery/**",
          "web/**",
          "wordlists/**"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
